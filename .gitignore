# --- Desktop Control Center (project-cam-desktop/, Tauri 2 + React) ---
# Build output only. Several GB of Rust/npm artifacts live here; `dist/` and
# `node_modules/*.json` were only incidentally covered by the generic rules
# above, so name them explicitly.
project-cam-desktop/node_modules/
project-cam-desktop/dist/
project-cam-desktop/src-tauri/target/
# Regenerated by `tauri build` from capabilities/ — never hand-edited.
project-cam-desktop/src-tauri/gen/
# Local-only tool state (brainstorm servers hold live PIDs).
project-cam-desktop/.superpowers/
project-cam-desktop/.claude/settings.local.json

# The blanket `*.json` rule above would otherwise silently drop every config
# the desktop app needs to build, leaving a fresh clone unbuildable — the same
# failure mode that broke CI in 2026-06 (see docs/current_status.md).
!project-cam-desktop/package.json
!project-cam-desktop/package-lock.json
!project-cam-desktop/tsconfig.json
!project-cam-desktop/tsconfig.node.json
!project-cam-desktop/src-tauri/tauri.conf.json
!project-cam-desktop/src-tauri/capabilities/*.json

# Academy KPI demo output (regenerated by demo/run_academy_demo.py).
demo/output/

# ---------------------------------------------------------------------------
# Added 2026-08-04 with the move to this clean tree. The previous repository's
# .git grew to 4 GB partly because these formats were never excluded: model
# checkpoints and raw camera footage are large, opaque, and reproducible from
# their source (a download URL or a re-recording), so they are data, not history.
*.pth
*.avi
*.mp4
garage_lab_combined/test_clips/
models/pose/
models/ball/

# The venv is a symlink to the archive tree, not project content.
venv
